{
  "name": "@rbt/office",
  "version": "0.1.40",
  "license": "MIT",
  "description": "Fable-compiled office libraries for browser applications",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    "./*": "./dist/*"
  },
  "scripts": {
    "_restore": "dotnet tool restore && (cd src/Dist && dotnet restore >/dev/null)",
    "build:fable": "bash scripts/build-dist.sh dist",
    "build": "pnpm run build:fable",
    "test": "bash tests/run-all.sh",
    "perf:browser": "npm --prefix tools/browser-runner run perf --"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
