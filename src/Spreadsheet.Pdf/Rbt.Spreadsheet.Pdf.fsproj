<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HeaderFooter.fs" />
    <Compile Include="Pagination.fs" />
    <Compile Include="Pdf.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Spreadsheet/Rbt.Spreadsheet.fsproj" />
    <ProjectReference Condition="'$(UseSiblingPackages)' != 'true'" Include="../../../rbt-pdf/Rbt.Pdf/Rbt.Pdf.fsproj" />
    <PackageReference Condition="'$(UseSiblingPackages)' == 'true'" Include="Rbt.Pdf" Version="$(RbtPdfPackageVersion)" />
  </ItemGroup>
</Project>
