<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Pdf.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Spreadsheet/Rbt.Spreadsheet.fsproj" />
    <PackageReference Include="Rbt.Pdf" Version="$(RbtPdfPackageVersion)" />
    <!-- (For the Fable build: Rbt.Pdf's Fable sources inflate with Rbt.OpenType's Inflate.) -->
    <PackageReference Include="Rbt.OpenType.Core" Version="$(RbtOpenTypePackageVersion)" />
  </ItemGroup>
</Project>
