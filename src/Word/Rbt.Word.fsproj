<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Rope.fs" />
    <Compile Include="TextBuffer.fs" />
    <Compile Include="Document.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="WordStyles.fs" />
    <Compile Include="BorderGrid.fs" />
    <Compile Include="WordLayout.fs" />
    <Compile Include="Math.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Paint.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Clipboard.fs" />
    <Compile Include="Docx.fs" />
    <Compile Include="Renderer.fs" />
    <Compile Include="WordViewer.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="Word.fs" />
    <Compile Include="WordVba.fs" />
    <Compile Include="WordUi.fs" />
    <Compile Include="WordDialogs.fs" />
    <Compile Include="WordHost.fs" />
    <Compile Include="WordShell.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FableUI/Rbt.FableUI.fsproj" />
    <ProjectReference Include="../OfficeUi/Rbt.OfficeUi.fsproj" />
    <ProjectReference Condition="'$(UseSiblingPackages)' != 'true'" Include="../../../rbt-vb/Rbt.Vb.fsproj" />
    <PackageReference Condition="'$(UseSiblingPackages)' == 'true'" Include="Rbt.Vb" Version="$(RbtVbPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.17.0" />
  </ItemGroup>
</Project>
