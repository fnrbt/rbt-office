<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Rope.fs" />
    <Compile Include="TextBuffer.fs" />
    <Compile Include="Document.fs" />
    <Compile Include="Shapes.fs" />
    <Compile Include="WordStyles.fs" />
    <Compile Include="Outline.fs" />
    <Compile Include="BorderGrid.fs" />
    <Compile Include="WordLayout.fs" />
    <Compile Include="Math.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="LayoutFingerprint.fs" />
    <Compile Include="Paint.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Clipboard.fs" />
    <Compile Include="TypedDocxImport.fs" />
    <Compile Include="TypedDocxExport.fs" />
    <Compile Include="Docx.fs" />
    <Compile Include="WordMacroApi.fs" />
    <Compile Include="WordTypeLibrary.fs" />
    <Compile Include="WordMacroHost.fs" />
    <Compile Include="WordMacroProject.fs" />
    <Compile Include="Renderer.fs" />
    <Compile Include="EmbeddedFontFaces.fs" />
    <Compile Include="WordViewer.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="Word.fs" />
    <Compile Include="WordVba.fs" />
