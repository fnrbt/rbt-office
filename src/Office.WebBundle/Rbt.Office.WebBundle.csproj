<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Rbt.Office.Web</PackageId>
    <Description>Immutable Fable output consumed by RedBat web releases.</Description>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectOfficeWebBundle</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CollectOfficeWebBundle">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.." Command="pnpm run build:fable" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)/../../dist/**/*">
        <PackagePath>contentFiles/any/any/office/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
