<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NumberText.fs" />
    <Compile Include="TableStyles.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="CellText.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="Workbook.fs" />
    <Compile Include="Pivot.fs" />
    <Compile Include="Formula.fs" />
    <Compile Include="Calc.fs" />
    <Compile Include="Recalc.fs" />
    <Compile Include="ConditionalFormatting.fs" />
    <Compile Include="SheetOps.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Charts.fs" />
    <Compile Include="Paint.fs" />
    <Compile Include="Png.fs" />
    <Compile Include="XlsxBridge.fs" />
    <Compile Include="XlsxImporter.fs" />
    <Compile Include="Tabs.fs" />
    <Compile Include="HostShapes.fs" />
    <Compile Include="PrintHeaderFooter.fs" />
    <Compile Include="Pagination.fs" />
    <Compile Include="Spreadsheet.fs" />
    <Compile Include="SpreadsheetVba.fs" />
    <Compile Include="Toolbar.fs" />
    <Compile Include="SpreadsheetUi.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Grid/Rbt.Grid.fsproj" />
    <ProjectReference Include="../OfficeUi/Rbt.OfficeUi.fsproj" />
    <ProjectReference Include="../Office.Formats/Rbt.OfficeFormat.fsproj" />
    <PackageReference Include="Rbt.Vb" Version="$(RbtVbPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
  </ItemGroup>
</Project>
