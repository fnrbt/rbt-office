<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ShaperText.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Word/Rbt.Word.fsproj" />
    <PackageReference Include="Rbt.Text.Engine" Version="$(RbtTextPackageVersion)" />
    <PackageReference Include="Rbt.OpenType.Core" Version="$(RbtOpenTypePackageVersion)" />
  </ItemGroup>
</Project>
