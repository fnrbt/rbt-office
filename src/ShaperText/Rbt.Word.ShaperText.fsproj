<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ShaperText.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Word/Rbt.Word.fsproj" />
    <ProjectReference Condition="'$(UseSiblingPackages)' != 'true'" Include="../../../rbt-text/engine/Rbt.Text.Engine.fsproj" />
    <PackageReference Condition="'$(UseSiblingPackages)' == 'true'" Include="Rbt.Text.Engine" Version="$(RbtTextPackageVersion)" />
    <ProjectReference Condition="'$(UseSiblingPackages)' != 'true'" Include="../../../rbt-text/opentype/Rbt.OpenType.Core.fsproj" />
    <PackageReference Condition="'$(UseSiblingPackages)' == 'true'" Include="Rbt.OpenType.Core" Version="$(RbtTextPackageVersion)" />
  </ItemGroup>
</Project>
