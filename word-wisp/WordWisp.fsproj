<Project Sdk="Microsoft.NET.Sdk">
  <!-- wisp-word: the native Word app on Wisp. Reuses RedBat.Word + the Wisp OfficeShell;
       no ../widgets. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../editor/KeyMap.fs" />
    <Compile Include="WordRender.fs" />
    <Compile Include="EditorHost.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../wisp/Wisp.fsproj" />
    <ProjectReference Include="../office-wisp/OfficeWisp.fsproj" />
    <ProjectReference Include="../src/Word/RedBat.Word.fsproj" />
    <ProjectReference Include="../src/Word.Import/WordImport.fsproj" />
    <ProjectReference Include="../src/Office.Formats/OfficeFormat.fsproj" />
    <ProjectReference Include="../src/OfficeUi/RedBat.OfficeUi.fsproj" />
    <ProjectReference Include="../../renderer/Renderer.fsproj" />
  </ItemGroup>
</Project>
