<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WordEditor.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Rbt.Widgets" Version="$(RbtWidgetsPackageVersion)" />
    <ProjectReference Include="../src/Word/Rbt.Word.fsproj" />
  </ItemGroup>
  <!-- The default font, for the painter's test: it ships in Rbt.Renderer.Core's
       package, which is downloaded for the file alone, not referenced. -->
  <ItemGroup>
    <PackageDownload Include="Rbt.Renderer.Core" Version="[$(RbtRendererPackageVersion)]" />
    <None Include="$(NuGetPackageRoot)rbt.renderer.core/$(RbtRendererPackageVersion)/assets/NotoSans-Regular.ttf" Link="NotoSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
