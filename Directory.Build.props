<Project>
  <!-- The libraries of the other Rbt repositories come from the Forge package
       registry, in every build; nothing refers to a neighbouring checkout.
       The rbt-vb, rbt-text and rbt-pdf packages carry their F# sources under
       fable/, which is what Fable compiles. The renderer and Wisp are what
       the native hosts and their runners are built on. -->
  <PropertyGroup>
    <!-- A library's output folder holds the package assemblies too, as it held
         the neighbouring checkouts' when they were project references: the
         .fsx suites load them from there. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RbtVbPackageVersion Condition="'$(RbtVbPackageVersion)' == ''">0.9.0</RbtVbPackageVersion>
    <RbtTextPackageVersion Condition="'$(RbtTextPackageVersion)' == ''">0.1.3</RbtTextPackageVersion>
    <!-- Rbt.Pdf 0.1.25 is compiled against Rbt.OpenType.Core 0.1.9; pinning
         OpenType to Rbt.Text.Engine's older version loads a different
         assembly and makes the subset/CID writer fail at runtime. -->
    <RbtOpenTypePackageVersion Condition="'$(RbtOpenTypePackageVersion)' == ''">0.1.9</RbtOpenTypePackageVersion>
    <RbtPdfPackageVersion Condition="'$(RbtPdfPackageVersion)' == ''">0.1.25</RbtPdfPackageVersion>
    <RbtRendererPackageVersion Condition="'$(RbtRendererPackageVersion)' == ''">0.1.4</RbtRendererPackageVersion>
    <RbtWispPackageVersion Condition="'$(RbtWispPackageVersion)' == ''">0.1.0</RbtWispPackageVersion>
  </PropertyGroup>
</Project>
