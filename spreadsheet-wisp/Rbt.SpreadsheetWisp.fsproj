<Project Sdk="Microsoft.NET.Sdk">
  <!-- wisp-spreadsheet: Wisp-native spreadsheet app. Reuses Rbt.Spreadsheet
       model/layout/paint plus OfficeShell chrome. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../office-wisp/KeyMap.fs" />
    <Compile Include="GridRender.fs" />
    <Compile Include="EditorHost.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Rbt.Wisp" Version="$(RbtWispPackageVersion)" />
    <ProjectReference Include="../office-wisp/Rbt.OfficeWisp.fsproj" />
    <ProjectReference Include="../src/Spreadsheet/Rbt.Spreadsheet.fsproj" />
    <ProjectReference Include="../src/Office.Formats/Rbt.OfficeFormat.fsproj" />
    <ProjectReference Include="../src/OfficeUi/Rbt.OfficeUi.fsproj" />
    <PackageReference Include="Rbt.Renderer" Version="$(RbtRendererPackageVersion)" />
  </ItemGroup>
</Project>
