<Project Sdk="Microsoft.NET.Sdk">
  <!-- wisp-spreadsheet: Wisp-native spreadsheet app. Reuses RedBat.Spreadsheet
       model/layout/paint plus OfficeShell chrome. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../editor/KeyMap.fs" />
    <Compile Include="GridRender.fs" />
    <Compile Include="EditorHost.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../wisp/Wisp.fsproj" />
    <ProjectReference Include="../office-wisp/OfficeWisp.fsproj" />
    <ProjectReference Include="../src/Spreadsheet/RedBat.Spreadsheet.fsproj" />
    <ProjectReference Include="../src/Office.Formats/OfficeFormat.fsproj" />
    <ProjectReference Include="../src/OfficeUi/RedBat.OfficeUi.fsproj" />
    <ProjectReference Include="../../renderer/Renderer.fsproj" />
  </ItemGroup>
</Project>
