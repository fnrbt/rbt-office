<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../native-runner/PngEncode.fs" />
    <Compile Include="../excel-native-runner/ChartRender.fs" />
    <Compile Include="../excel-native-runner/Program.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Office.Formats/Rbt.OfficeFormat.fsproj" />
    <ProjectReference Include="../../src/Spreadsheet/Rbt.Spreadsheet.fsproj" />
    <ProjectReference Include="../../src/Spreadsheet.Pdf/Rbt.Spreadsheet.Pdf.fsproj" />
    <ProjectReference Include="../../spreadsheet-native/Rbt.SpreadsheetWidgets.fsproj" />
    <PackageReference Include="Rbt.Widgets" Version="$(RbtWidgetsPackageVersion)" />
    <PackageReference Include="Rbt.Renderer" Version="$(RbtRendererPackageVersion)" />
  </ItemGroup>
</Project>
