<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Office.Formats/Rbt.OfficeFormat.fsproj" />
    <ProjectReference Include="../../src/Word/Rbt.Word.fsproj" />
    <!-- ../text shaping engine (Fable-compiled) for the optional ?measure=text path -->
    <ProjectReference Include="../../src/ShaperText/Rbt.Word.ShaperText.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.17.0" />
  </ItemGroup>
</Project>
