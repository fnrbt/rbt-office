<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Match the runtime required by the text packages; shared libraries
         retain the SDK FSharp.Core version for dotnet fsi consumers. -->
    <FSharpCoreImplicitPackageVersion>10.1.401</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Office.Formats/Rbt.OfficeFormat.fsproj" />
    <ProjectReference Include="../../src/Word/Rbt.Word.fsproj" />
    <ProjectReference Include="../../src/Word.Import/Rbt.WordImport.fsproj" />
    <ProjectReference Include="../../src/Word.Pdf/Rbt.Word.Pdf.fsproj" />
    <ProjectReference Include="../../office-wisp/native/Rbt.OfficeNative.fsproj" />
  </ItemGroup>
</Project>
