<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Office.Formats/Rbt.OfficeFormat.fsproj" />
    <ProjectReference Include="../../src/Word/Rbt.Word.fsproj" />
    <ProjectReference Include="../../src/Word.Import/Rbt.WordImport.fsproj" />
    <ProjectReference Include="../../src/Word.Pdf/Rbt.Word.Pdf.fsproj" />
    <ProjectReference Include="../../word-native/Rbt.WordWidgets.fsproj" />
    <PackageReference Include="Rbt.Widgets" Version="$(RbtWidgetsPackageVersion)" />
    <PackageReference Include="Rbt.Renderer" Version="$(RbtRendererPackageVersion)" />
  </ItemGroup>
</Project>
