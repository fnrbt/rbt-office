#load "function-table-kit.fsx"
open Rbt.Spreadsheet.Model
open Rbt.Spreadsheet.Formula
open ``Function-table-kit``

// The Bonds and Complex modules and the error function, Bessel functions and CONVERT of the
// Engineering module, against Excel 2019: every expected value below is Excel's own, taken from
// tools/excel-parity/{bonds,complex,engineering}-excel.tsv (the probes of make-*-probe.py; the
// full comparison is tools/excel-parity/function-parity-engine.fsx). Numbers to a relative
// tolerance: 1e-13 where the engine computes as Excel does, looser where Excel iterates (YIELD,
// ODDFYIELD: its stopping point) or its Bessel J of x >= 8 is not Numerical Recipes' form.
let m = empty

let rel (m: SpreadsheetModel) (formula: string) (expected: float) (tolerance: float) =
    match value m formula with
    | CellValue.Number x when (if expected = 0.0 then abs x <= tolerance else abs (x - expected) <= tolerance * abs expected) -> pass <- pass + 1
    | other -> (fail <- fail + 1; printfn "FAIL rel %s expected %.17g  got %A" formula expected other)

