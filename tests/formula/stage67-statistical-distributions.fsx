// The distributions, tests and least-squares fits of FnStatDist and
// FnStatistical. Every expected value is what Excel 2019 computed for the
// cell (tools/excel-parity/statdist-excel-results.tsv, made by
// make-statdist-probe.py): numbers to Excel's 15 significant digits, errors
// by kind. statdist-compare.fsx compares all 6000 probe cells.

// The probe's data block: H y, I x1, J x2, K 2*x1 (collinear), L text, blank,
// logical and numbers, M blank, N y > 0; H12:Q12 and H13:Q13 a row of y and
// x; H15:J16 observed and H18:J19 expected counts.
let column (letter: char) = int letter - int 'A'
let data =
    let y = [ 3.1; 4.9; 7.2; 8.8; 11.3; 12.7; 15.2; 16.9; 19.4; 20.8 ]
    let x2 = [ 2.5; 1.0; 4.2; 3.3; 6.1; 5.0; 7.7; 6.4; 9.9; 8.2 ]
    let l = [ N 4.5; S "text"; CellValue.Empty; B true; N 6.0; N 7.5; CellValue.Empty; N 2.0; N 9.0; N 1.0 ]
    let ny = [ 1.2; 1.9; 3.1; 4.8; 7.9; 12.1; 19.8; 30.5; 50.2; 79.1 ]
    [ for r in 0 .. 9 do
        yield (r, column 'H'), N y.[r]
        yield (r, column 'I'), N (float (r + 1))
        yield (r, column 'J'), N x2.[r]
        yield (r, column 'K'), N (float (2 * (r + 1)))
        if l.[r] <> CellValue.Empty then yield (r, column 'L'), l.[r]
        yield (r, column 'N'), N ny.[r]
      for c in 0 .. 9 do
        yield (11, column 'H' + c), N y.[c]
        yield (12, column 'H' + c), N (float (c + 1))
      for r, row in List.indexed [ [ 58.0; 35.0; 7.0 ]; [ 11.0; 25.0; 23.0 ] ] do
        for c, v in List.indexed row -> (14 + r, column 'H' + c), N v
      for r, row in List.indexed [ [ 45.35; 47.65; 10.0 ]; [ 17.56; 18.44; 23.0 ] ] do
        for c, v in List.indexed row -> (17 + r, column 'H' + c), N v ]
    |> modelOf
let d = data

/// Excel's value to its 15 significant digits.
let excel (formula: string) (expected: float) =
    match value d formula with
    | CellValue.Number x when x = expected || abs (x - expected) <= 1e-14 * abs expected -> pass <- pass + 1
    | other -> (fail <- fail + 1; printfn "FAIL %s expected %.15g got %A" formula expected other)

