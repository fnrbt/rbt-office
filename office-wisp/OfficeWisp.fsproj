<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Wisp backend for the Office UI abstraction (renders RedBat.Office.Ui specs onto Wisp),
       the office UI shell for the Wisp apps (word-wisp / spreadsheet-wisp). Replaced the Composit office-native shell in Jul 2026. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OfficeShell.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../wisp/Wisp.fsproj" />
    <ProjectReference Include="../src/OfficeUi/RedBat.OfficeUi.fsproj" />
    <ProjectReference Include="../../renderer/Renderer.fsproj" />
  </ItemGroup>
</Project>
