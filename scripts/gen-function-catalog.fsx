// dotnet fsi scripts/gen-function-catalog.fsx [--check]
//
// Writes src/Spreadsheet/FunctionCatalog.fs from the function modules of
// src/Spreadsheet/Functions (every `Fn*` module: its `moduleName` and
// `functions`), read from the built library - so build src/Spreadsheet first,
// and build it again after the catalog changed. With --check it writes
// nothing and fails when the catalog is not what the modules say.
#r "nuget: Fable.Core, 4.3.0"
#r "../src/Spreadsheet/bin/Debug/netstandard2.0/Rbt.Spreadsheet.dll"

open System
open System.IO
open System.Text
open Rbt.Spreadsheet.Formula

let root = Path.GetFullPath(Path.Combine(__SOURCE_DIRECTORY__, ".."))
let target = Path.Combine(root, "src/Spreadsheet/FunctionCatalog.fs")
let check = fsi.CommandLineArgs |> Array.contains "--check"

let assembly = typeof<FunctionDef>.Assembly
let modules =
    assembly.GetTypes()
    |> Array.filter (fun t -> t.Namespace = "Rbt.Spreadsheet.Functions" && t.Name.StartsWith "Fn" && not (t.Name.Contains "@"))
    |> Array.sortBy (fun t -> t.Name)
    |> Array.map (fun t ->
        let name = t.GetProperty("moduleName").GetValue(null) :?> string
        let defs = t.GetProperty("functions").GetValue(null) :?> FunctionDef list
        t.Name, name, defs)

let quote (s: string) = "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\""
let sb = StringBuilder()
let line (s: string) = sb.Append(s).Append('\n') |> ignore
line "/// Generated by scripts/gen-function-catalog.fsx from the modules of"
line "/// src/Spreadsheet/Functions - do not edit. The names, lifting signatures and"
line "/// flags of every function the modules provide, known before a module is"
line "/// loaded, and (in the browser) the dynamic import of each module."
line "module Rbt.Spreadsheet.FunctionCatalog"
line ""
line "#if FABLE_COMPILER"
line "open Fable.Core"
line "#endif"
line ""
line "/// `Flags`: 1 volatile, 2 gives an array."
line "type Entry = { Name: string; Module: string; Signature: string; Flags: int }"
line ""
line ("let modules : string array = [| " + String.Join("; ", modules |> Array.map (fun (_, name, _) -> quote name)) + " |]")
line ""
line "let entries : Entry array ="
line "    [|"
let seen = Collections.Generic.HashSet<string>()
for (_, moduleName, defs) in modules do
    for def in defs |> List.sortBy (fun d -> d.Name) do
        if not (seen.Add def.Name) then failwithf "%s is in two modules" def.Name
        let flags = (if def.Volatile then 1 else 0) ||| (match def.Impl with ArrayFunction _ -> 2 | ScalarFunction _ -> 0)
        line (sprintf "       { Name = %s; Module = %s; Signature = %s; Flags = %d }" (quote def.Name) (quote moduleName) (quote def.Signature) flags)
line "    |]"
line ""
line "#if FABLE_COMPILER"
line "[<Emit(\"Promise.resolve()\")>]"
line "let private resolved () : JS.Promise<unit> = jsNative"
line ""
for (typeName, moduleName, _) in modules do
    line (sprintf "[<Emit(\"import(\\\"./Functions/%s.js\\\").then((m) => { m.install(); })\")>]" typeName)
    line (sprintf "let private load%s () : JS.Promise<unit> = jsNative" typeName)
line ""
line "/// Fetch and install a module (its `install`)."
line "let load (moduleName: string) : JS.Promise<unit> ="
line "    match moduleName with"
for (typeName, moduleName, _) in modules do
    line (sprintf "    | %s -> load%s ()" (quote moduleName) typeName)
line "    | _ -> resolved ()"
line "#endif"

let text = sb.ToString()
let current = if File.Exists target then File.ReadAllText target else ""
if check then
    if current <> text then
        eprintfn "src/Spreadsheet/FunctionCatalog.fs is not what the modules say: run dotnet fsi scripts/gen-function-catalog.fsx and build again"
        exit 1
    printfn "function catalog: %d functions of %d modules, up to date" seen.Count modules.Length
else
    if current <> text then File.WriteAllText(target, text)
    printfn "function catalog: %d functions of %d modules%s" seen.Count modules.Length (if current <> text then " (written)" else " (unchanged)")
